# DeepSeek AI 分析
DEEPSEEK_API_KEY=your_deepseek_api_key_here
THESIS_PARSER_MODEL=deepseek-chat
THESIS_PARSER_TIMEOUT_SECONDS=8
# Optional dedicated secret; when omitted the parser reuses DEEPSEEK_API_KEY.
# THESIS_PARSER_API_KEY=your_dedicated_parser_key_here

# Qualified, immutable SQLite OHLCV store used only for historical thesis tests.
# The selector never stitches this store to PAPER_DB_PATH.
# THESIS_HISTORICAL_DB_PATH=/absolute/path/to/canonical_ohlcv.db
# THESIS_HISTORICAL_DB_SHA256=expected_immutable_database_sha256
# THESIS_HISTORICAL_DATASET_ID=declared_catalog_or_manifest_identity
# Production should explicitly require the immutable store.
THESIS_HISTORICAL_REQUIRE_IMMUTABLE=true

# Persistent, isolated saved-thesis state. Use a durable volume in production.
# THESIS_TRACKING_DB_PATH=/absolute/persistent/path/thesis_tracking.db
THESIS_TRACKING_SCHEDULER_ENABLED=false
THESIS_TRACKING_SCHEDULER_CADENCE_SECONDS=900

# Optional enum-only emphasis selector. Explanations remain deterministic when disabled/unavailable.
THESIS_EXPLANATION_ENABLED=false
THESIS_EXPLANATION_MODEL=deepseek-chat
THESIS_EXPLANATION_TIMEOUT_SECONDS=8
# THESIS_EXPLANATION_API_KEY_FILE=/run/secrets/deepseek_api_key

# Server酱微信推送
SERVERCHAN_KEY=your_serverchan_key_here

# Telegram（可选）
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Binance API（只需行情权限）
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET=your_binance_secret_here

# Bybit API（未来实盘用）
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_SECRET=your_bybit_secret_here
