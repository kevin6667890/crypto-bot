[Unit]
Description=Crypto Bot Polymarket one-shot incremental collector
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/crypto-bot/polymarket-runtime.env
ExecStart=/usr/bin/flock --nonblock /run/lock/crypto-bot-polymarket-collector.lock /usr/local/libexec/crypto-bot-polymarket-job collect
TimeoutStartSec=90min
KillSignal=SIGTERM
SendSIGKILL=yes
Restart=no
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
