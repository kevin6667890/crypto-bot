# Installed as /etc/crypto-bot/polymarket-runtime.env (root:root, mode 0600).
# Values are paths/identities only. Never put the provider key value here.
POLYMARKET_RELEASE_DIR=/opt/crypto-bot-canonical-staging/RELEASE_ID
POLYMARKET_RUNTIME_ENV=/opt/crypto-bot-canonical-staging/RELEASE_ID/deployment/integration.env
