          "latest_timestamp": { "allOf": [{ "$ref": "#/components/schemas/UnixSeconds" }], "nullable": true },
          "raw_row_count": { "type": "integer" },
          "returned_point_count": { "type": "integer" },
          "resolution": { "type": "string", "nullable": true },
          "resolution_seconds": { "type": "integer", "nullable": true },
          "stale": { "type": "boolean" },
          "stale_after_seconds": { "type": "integer" },
          "status": { "type": "string" },
          "gap_reason": { "type": "string", "nullable": true },
          "source_coverage": { "type": "object", "additionalProperties": true },
          "data_as_of": { "allOf": [{ "$ref": "#/components/schemas/UnixSeconds" }], "nullable": true },
          "last_completed_bucket": { "$ref": "#/components/schemas/UnixSeconds" },
