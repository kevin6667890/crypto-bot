{
  "openapi": "3.0.3",
  "info": { "title": "Crypto-Bot read-only dashboard API", "version": "1.0.0" },
  "servers": [{ "url": "/" }],
  "paths": {
    "/api/operations/summary": {
      "get": { "operationId": "getOperationsSummary", "responses": { "200": { "description": "Public operations summary", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OperationsSummary" } } } } } }
    },
    "/api/operations/trends": {
      "get": {
        "operationId": "getOperationsTrends",
        "parameters": [{ "name": "window", "in": "query", "schema": { "type": "string", "enum": ["1h", "6h", "24h"], "default": "24h" } }],
        "responses": { "200": { "description": "Minute-bucketed local trend history", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OperationsTrends" } } } } }
      }
    },
    "/api/research/microstructure/health": {
      "get": { "operationId": "getMicrostructureHealth", "responses": { "200": { "description": "Read-only health summary", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MicrostructureHealth" } } } } } }
    },
    "/api/research/microstructure/coverage": {
      "get": { "operationId": "getMicrostructureCoverage", "responses": { "200": { "description": "Coverage summary", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CoverageSummary" } } } } } }
    },
    "/api/research/microstructure/eligibility": {
      "get": { "operationId": "getMicrostructureEligibility", "responses": { "200": { "description": "Eligibility summary", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EligibilitySummary" } } } } } }
    },
    "/api/paper/flow/history/v1": {
      "get": {
        "operationId": "getFlowHistory",
        "parameters": [
          { "name": "instrument", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "series", "in": "query", "required": true, "schema": { "type": "string", "enum": ["cvd", "oi"] } },
          { "name": "timeframe", "in": "query", "required": true, "schema": { "type": "string", "enum": ["1m", "5m", "15m", "1h", "4h", "1D"] } },
          { "name": "start", "in": "query", "schema": { "$ref": "#/components/schemas/UnixSeconds" } },
          { "name": "end", "in": "query", "schema": { "$ref": "#/components/schemas/UnixSeconds" } },
          { "name": "max_points", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 500 } },
          { "name": "cursor", "in": "query", "schema": { "type": "string" } },
          { "name": "cvd_mode", "in": "query", "schema": { "type": "string", "enum": ["CONTINUOUS", "UTC_DAILY_RESET"] } },
          { "name": "schema_version", "in": "query", "required": true, "schema": { "type": "string", "enum": ["canonical-microstructure-schema-v1"] } },
          { "name": "history_version", "in": "query", "required": true, "schema": { "type": "string", "enum": ["canonical-microstructure-history-v1"] } }
        ],
        "responses": { "200": { "description": "Flow history contract; the array field is points, never data", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FlowHistoryResponse" } } } } }
      }
    },
    "/api/data-coverage": {
      "get": { "operationId": "getDataCoverage", "responses": { "200": { "description": "Research data coverage", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DataCoverageResponse" } } } } } }
    },
    "/api/market/context": {
      "get": {
        "operationId": "getMarketAnalysisContextV2",
        "description": "Read-only causal facts and indicators from bounded confirmed data. It never emits a trading signal or invokes order logic.",
        "parameters": [
          { "name": "instrument", "in": "query", "required": true, "schema": { "type": "string", "maxLength": 48 }, "example": "ETH-USDT-SWAP" },
          { "name": "as_of", "in": "query", "required": false, "schema": { "$ref": "#/components/schemas/UnixSeconds" } },
          { "name": "execution_timeframe", "in": "query", "required": false, "schema": { "$ref": "#/components/schemas/MarketTimeframeV2" } }
        ],
        "responses": {
          "200": { "description": "MarketAnalysisContextV2", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MarketAnalysisContextV2" } } } },
          "400": { "description": "Invalid bounded query", "content": { "application/json": { "schema": { "type": "object", "required": ["error"], "properties": { "error": { "type": "string" } } } } } }
        }
      }
    },
    "/api/market/state": {
      "get": {
        "operationId": "getMarketStateV2",
        "description": "Read-only deterministic market-state recognition. This is not a trading signal.",
        "parameters": [
          { "name": "instrument", "in": "query", "required": true, "schema": { "type": "string", "maxLength": 48 } },
          { "name": "as_of", "in": "query", "schema": { "$ref": "#/components/schemas/UnixSeconds" } },
          { "name": "execution_timeframe", "in": "query", "schema": { "$ref": "#/components/schemas/MarketTimeframeV2" } }
        ],
        "responses": { "200": { "description": "MarketStateSnapshotV2", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MarketStateSnapshotV2" } } } }, "400": { "description": "Invalid bounded query" } }
      }
    },
    "/api/market/state/compare": {
      "get": {
        "operationId": "compareMarketStatesV2",
        "description": "Bounded comparison of exactly two causal market contexts.",
        "parameters": [
          { "name": "instrument", "in": "query", "required": true, "schema": { "type": "string", "maxLength": 48 } },
          { "name": "previous_as_of", "in": "query", "required": true, "schema": { "$ref": "#/components/schemas/UnixSeconds" } },
          { "name": "current_as_of", "in": "query", "required": true, "schema": { "$ref": "#/components/schemas/UnixSeconds" } },
          { "name": "execution_timeframe", "in": "query", "schema": { "$ref": "#/components/schemas/MarketTimeframeV2" } }
        ],
        "responses": { "200": { "description": "Two snapshots and their deterministic transitions", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MarketStateComparisonV2" } } } }, "400": { "description": "Invalid bounded comparison" } }
      }
    }
  },
  "components": {
    "schemas": {
      "UnixSeconds": { "type": "integer", "format": "int64", "description": "Unix timestamp in whole seconds.", "x-time-unit": "seconds" },
      "UnixMilliseconds": { "type": "integer", "format": "int64", "description": "Unix timestamp in whole milliseconds.", "x-time-unit": "milliseconds" },
      "IsoTimestamp": { "type": "string", "format": "date-time", "description": "RFC 3339 UTC timestamp." },
      "MarketTimeframeV2": { "type": "string", "enum": ["15m", "1H", "4H", "1D", "1W"], "default": "15m" },
      "IndicatorValueV2": {
        "type": "object",
        "required": ["value", "source_timestamp", "available", "stale", "partial", "warmup_complete", "calculation_version"],
        "properties": {
          "value": { "nullable": true, "oneOf": [{ "type": "number" }, { "type": "string" }] },
          "source_timestamp": { "allOf": [{ "$ref": "#/components/schemas/UnixSeconds" }], "nullable": true },
          "available": { "type": "boolean" }, "stale": { "type": "boolean" },
          "partial": { "type": "boolean" }, "warmup_complete": { "type": "boolean" },
          "calculation_version": { "type": "string" }
        }
      },
      "DataGapV2": {
        "type": "object", "required": ["start", "end", "missing_bars"],
        "properties": { "source": { "type": "string" }, "start": { "$ref": "#/components/schemas/UnixSeconds" }, "end": { "$ref": "#/components/schemas/UnixSeconds" }, "missing_bars": { "type": "integer", "minimum": 1 } }
      },
      "DataQualityV2": {
        "type": "object", "required": ["status", "source_timestamp", "stale", "partial", "missing", "gaps", "notes"],
        "properties": {
          "status": { "type": "string", "enum": ["AVAILABLE", "STALE", "PARTIAL", "MISSING"] },
          "source_timestamp": { "allOf": [{ "$ref": "#/components/schemas/UnixSeconds" }], "nullable": true },
          "stale": { "type": "boolean" }, "partial": { "type": "boolean" }, "missing": { "type": "boolean" },
          "gaps": { "type": "array", "items": { "$ref": "#/components/schemas/DataGapV2" } },
          "notes": { "type": "array", "items": { "type": "string" } }
        }
      },
      "IndicatorGroupV2": { "type": "object", "additionalProperties": { "$ref": "#/components/schemas/IndicatorValueV2" } },
      "TimeframeMarketContextV2": {
        "type": "object",
        "required": ["candle_close_ts", "confirmed", "trend", "momentum", "volatility", "structure", "volume", "quality"],
        "properties": {
          "candle_close_ts": { "allOf": [{ "$ref": "#/components/schemas/UnixSeconds" }], "nullable": true },
          "confirmed": { "type": "boolean" },
          "trend": { "$ref": "#/components/schemas/IndicatorGroupV2" },
          "momentum": { "$ref": "#/components/schemas/IndicatorGroupV2" },
          "volatility": { "$ref": "#/components/schemas/IndicatorGroupV2" },
          "structure": { "$ref": "#/components/schemas/IndicatorGroupV2" },
          "volume": { "$ref": "#/components/schemas/IndicatorGroupV2" },
          "quality": { "$ref": "#/components/schemas/DataQualityV2" }
        }
      },
      "MarketLevelV2": {
        "type": "object", "required": ["type", "timeframe", "value", "source_timestamp", "distance_pct", "touches", "confirmed", "confluence_sources", "calculation_version"],
        "properties": {
          "type": { "type": "string" }, "timeframe": { "type": "string" }, "value": { "type": "number" },
          "source_timestamp": { "$ref": "#/components/schemas/UnixSeconds" }, "distance_pct": { "type": "number" },
          "touches": { "type": "integer", "minimum": 0 }, "confirmed": { "type": "boolean" },
          "confluence_sources": { "type": "array", "items": { "type": "string" } }, "calculation_version": { "type": "string" }
        }
      },
      "CombinationFactV2": {
        "type": "object", "required": ["state", "observation_window_seconds", "start_timestamp", "end_timestamp", "price_change_pct", "data_quality", "calculation_version"],
        "properties": {
          "state": { "type": "string", "enum": ["PRICE_UP_OI_UP", "PRICE_UP_OI_DOWN", "PRICE_DOWN_OI_UP", "PRICE_DOWN_OI_DOWN", "PRICE_UP_CVD_UP", "PRICE_UP_CVD_DOWN", "PRICE_DOWN_CVD_UP", "PRICE_DOWN_CVD_DOWN", "INSUFFICIENT_DATA"] },
          "observation_window_seconds": { "type": "integer" },
          "start_timestamp": { "allOf": [{ "$ref": "#/components/schemas/UnixSeconds" }], "nullable": true },
          "end_timestamp": { "allOf": [{ "$ref": "#/components/schemas/UnixSeconds" }], "nullable": true },
          "price_change_pct": { "type": "number", "nullable": true }, "oi_change": { "type": "number", "nullable": true },
          "cvd_change": { "type": "number", "nullable": true }, "data_quality": { "type": "string" }, "calculation_version": { "type": "string" }
        }
      },
      "FlowContextV2": {
        "type": "object", "required": ["cvd", "oi", "funding", "basis", "vpvr", "price_oi_combination", "price_cvd_combination"],
        "properties": {
          "cvd": { "$ref": "#/components/schemas/IndicatorGroupV2" }, "oi": { "$ref": "#/components/schemas/IndicatorGroupV2" },
          "funding": { "$ref": "#/components/schemas/IndicatorGroupV2" }, "basis": { "$ref": "#/components/schemas/IndicatorGroupV2" },
          "vpvr": { "$ref": "#/components/schemas/IndicatorGroupV2" },
          "price_oi_combination": { "$ref": "#/components/schemas/CombinationFactV2" },
          "price_cvd_combination": { "$ref": "#/components/schemas/CombinationFactV2" }
        }
      },
      "OverallDataQualityV2": {
        "type": "object", "required": ["overall_status", "stale_sources", "partial_sources", "missing_sources", "gaps"],
        "properties": {
          "overall_status": { "type": "string", "enum": ["AVAILABLE", "STALE", "PARTIAL", "MISSING"] },
          "stale_sources": { "type": "array", "items": { "type": "string" } },
          "partial_sources": { "type": "array", "items": { "type": "string" } },
          "missing_sources": { "type": "array", "items": { "type": "string" } },
          "gaps": { "type": "array", "items": { "$ref": "#/components/schemas/DataGapV2" } }
        }
      },
      "MarketAnalysisContextV2": {
        "type": "object", "required": ["version", "instrument", "as_of", "execution_timeframe", "price", "timeframes", "flow", "levels", "quality"],
        "properties": {
          "version": { "type": "string", "enum": ["market-analysis-context-v2"] }, "instrument": { "type": "string" },
          "as_of": { "$ref": "#/components/schemas/UnixSeconds" }, "execution_timeframe": { "$ref": "#/components/schemas/MarketTimeframeV2" },
          "price": { "$ref": "#/components/schemas/IndicatorValueV2" },
          "timeframes": {
            "type": "object", "required": ["15m", "1H", "4H", "1D", "1W"],
            "properties": { "15m": { "$ref": "#/components/schemas/TimeframeMarketContextV2" }, "1H": { "$ref": "#/components/schemas/TimeframeMarketContextV2" }, "4H": { "$ref": "#/components/schemas/TimeframeMarketContextV2" }, "1D": { "$ref": "#/components/schemas/TimeframeMarketContextV2" }, "1W": { "$ref": "#/components/schemas/TimeframeMarketContextV2" } }
          },
          "flow": { "$ref": "#/components/schemas/FlowContextV2" }, "levels": { "type": "array", "items": { "$ref": "#/components/schemas/MarketLevelV2" } },
          "quality": { "$ref": "#/components/schemas/OverallDataQualityV2" }
        }
      },
      "StateEvidenceV2": {
        "type": "object", "required": ["code", "timeframe", "value", "weight", "source_timestamp", "quality", "classification"],
        "properties": {
          "code": { "type": "string" }, "timeframe": { "type": "string" }, "value": { "nullable": true }, "weight": { "type": "number" },
          "source_timestamp": { "allOf": [{ "$ref": "#/components/schemas/UnixSeconds" }], "nullable": true },
          "quality": { "type": "string" }, "classification": { "type": "string", "enum": ["supporting", "conflicting", "unavailable"] }
        }
      },
      "TimeframeStateV2": {
        "type": "object", "required": ["timeframe", "role", "primary_state", "primary_state_code", "evidence_strength", "quality", "momentum_state", "overlays", "source_timestamps", "supporting_evidence", "conflicting_evidence", "unavailable_evidence", "limitations"],
        "properties": {
          "timeframe": { "$ref": "#/components/schemas/MarketTimeframeV2" }, "role": { "type": "string" },
          "primary_state": { "type": "string", "enum": ["TREND_UP", "TREND_DOWN", "RANGE_LOW_VOLATILITY", "RANGE_HIGH_VOLATILITY", "TRANSITION_UP", "TRANSITION_DOWN", "TRANSITION_MIXED", "UNKNOWN"] },
          "primary_state_code": { "type": "string" }, "evidence_strength": { "type": "number", "minimum": 0, "maximum": 100 },
          "quality": { "$ref": "#/components/schemas/DataQualityV2" }, "momentum_state": { "type": "string" },
          "overlays": { "type": "array", "items": { "type": "string" } }, "source_timestamps": { "type": "array", "items": { "$ref": "#/components/schemas/UnixSeconds" } },
          "supporting_evidence": { "type": "array", "items": { "type": "string" } }, "conflicting_evidence": { "type": "array", "items": { "type": "string" } },
          "unavailable_evidence": { "type": "array", "items": { "type": "string" } }, "limitations": { "type": "array", "items": { "type": "string" } }
        }
      },
      "LevelInteractionV2": {
        "type": "object", "required": ["level_type", "timeframe", "zone_low", "zone_high", "boundary", "distance_pct", "approach_direction", "interaction_type", "touch_count", "reclaim_status", "source_timestamps", "quality", "cvd_oi_quality", "current_stage"],
        "properties": {
          "level_type": { "type": "string" }, "timeframe": { "type": "string" }, "zone_low": { "type": "number" }, "zone_high": { "type": "number" }, "boundary": { "type": "number" }, "distance_pct": { "type": "number" },
          "approach_direction": { "type": "string" }, "interaction_type": { "type": "string", "enum": ["APPROACHING", "TOUCHING", "REJECTED", "BROKEN", "RECLAIMED", "RETESTING", "INSIDE_ZONE", "UNKNOWN"] },
          "touch_count": { "type": "integer" }, "rejection_strength": { "type": "number", "nullable": true }, "reclaim_status": { "type": "string" },
          "source_timestamps": { "type": "array", "items": { "$ref": "#/components/schemas/UnixSeconds" } },
          "quality": { "type": "string" }, "breakout_timestamp": { "allOf": [{ "$ref": "#/components/schemas/UnixSeconds" }], "nullable": true },
          "confirmation_timestamp": { "allOf": [{ "$ref": "#/components/schemas/UnixSeconds" }], "nullable": true }, "reclaim_timestamp": { "allOf": [{ "$ref": "#/components/schemas/UnixSeconds" }], "nullable": true },
          "volume_ratio": { "type": "number", "nullable": true }, "cvd_oi_quality": { "type": "string" }, "current_stage": { "type": "string" }, "invalidation_reason": { "type": "string", "nullable": true }
        }
      },
      "CrossTimeframeAlignmentV2": {
        "type": "object", "required": ["state", "supporting_timeframes", "conflicting_timeframes", "missing_timeframes", "normal_pullback", "countertrend_lower_timeframe_move", "structure_state", "environment_state", "setup_state", "trigger_state"],
        "properties": { "state": { "type": "string" }, "supporting_timeframes": { "type": "array", "items": { "type": "string" } }, "conflicting_timeframes": { "type": "array", "items": { "type": "string" } }, "missing_timeframes": { "type": "array", "items": { "type": "string" } }, "normal_pullback": { "type": "boolean" }, "countertrend_lower_timeframe_move": { "type": "boolean" }, "structure_state": { "type": "string" }, "environment_state": { "type": "string" }, "setup_state": { "type": "string" }, "trigger_state": { "type": "string" } }
      },
      "StateTransitionV2": {
        "type": "object", "required": ["from_state", "to_state", "transition_timestamp", "trigger_evidence", "source_candle_timestamps", "confirmation_status", "invalidation_reason"],
        "properties": { "from_state": { "type": "string" }, "to_state": { "type": "string" }, "transition_timestamp": { "$ref": "#/components/schemas/UnixSeconds" }, "trigger_evidence": { "type": "array", "items": { "type": "string" } }, "source_candle_timestamps": { "type": "array", "items": { "$ref": "#/components/schemas/UnixSeconds" } }, "confirmation_status": { "type": "string" }, "invalidation_reason": { "type": "string", "nullable": true } }
      },
      "MarketStateSnapshotV2": {
        "type": "object", "required": ["version", "definition_version", "instrument", "as_of", "execution_timeframe", "primary_state", "primary_state_code", "evidence_strength", "quality", "timeframes", "cross_timeframe", "level_interactions", "overlays", "transitions", "evidence", "limitations"],
        "properties": {
          "version": { "type": "string", "enum": ["market-state-engine-v2"] }, "definition_version": { "type": "string" }, "instrument": { "type": "string" }, "as_of": { "$ref": "#/components/schemas/UnixSeconds" }, "execution_timeframe": { "$ref": "#/components/schemas/MarketTimeframeV2" },
          "primary_state": { "type": "string" }, "primary_state_code": { "type": "string" }, "evidence_strength": { "type": "number", "minimum": 0, "maximum": 100 }, "quality": { "$ref": "#/components/schemas/OverallDataQualityV2" },
          "timeframes": { "type": "object", "additionalProperties": { "$ref": "#/components/schemas/TimeframeStateV2" } }, "cross_timeframe": { "$ref": "#/components/schemas/CrossTimeframeAlignmentV2" },
          "level_interactions": { "type": "array", "items": { "$ref": "#/components/schemas/LevelInteractionV2" } }, "overlays": { "type": "array", "items": { "type": "string" } }, "transitions": { "type": "array", "items": { "$ref": "#/components/schemas/StateTransitionV2" } }, "evidence": { "type": "array", "items": { "$ref": "#/components/schemas/StateEvidenceV2" } }, "limitations": { "type": "array", "items": { "type": "string" } }
        }
      },
      "MarketStateComparisonV2": {
        "type": "object", "required": ["version", "previous", "current", "transitions"],
        "properties": { "version": { "type": "string" }, "previous": { "$ref": "#/components/schemas/MarketStateSnapshotV2" }, "current": { "$ref": "#/components/schemas/MarketStateSnapshotV2" }, "transitions": { "type": "array", "items": { "$ref": "#/components/schemas/StateTransitionV2" } } }
      },
      "OperationsSummary": {
        "type": "object",
        "required": ["generated_at", "service", "frontend", "paper_api", "collector", "query_plane", "database", "wal_size_bytes", "maintenance", "scheduler", "tasks", "warning_count", "storage", "system"],
        "properties": {
          "generated_at": { "$ref": "#/components/schemas/IsoTimestamp" },
          "service": { "type": "object", "required": ["status", "version", "git_commit", "uptime_seconds"], "properties": { "status": { "type": "string" }, "version": { "type": "string" }, "git_commit": { "type": "string" }, "uptime_seconds": { "type": "number" } } },
          "frontend": { "type": "object", "required": ["status"], "properties": { "status": { "type": "string" } } },
          "paper_api": { "type": "object", "required": ["status", "collector_freshness"], "properties": { "status": { "type": "string" }, "collector_freshness": { "type": "object", "additionalProperties": { "type": "object", "required": ["status"], "properties": { "updated_at": { "allOf": [{ "$ref": "#/components/schemas/IsoTimestamp" }], "nullable": true }, "age_seconds": { "type": "number", "nullable": true }, "status": { "type": "string" } } } } } },
          "collector": { "type": "object", "required": ["status", "queue_depth"], "properties": { "status": { "type": "string" }, "queue_depth": { "type": "integer" }, "last_success_data_time": { "allOf": [{ "$ref": "#/components/schemas/IsoTimestamp" }], "nullable": true }, "write_latency_ms": { "type": "number", "nullable": true } }, "additionalProperties": true },
          "query_plane": { "type": "object", "required": ["status", "components"], "properties": { "status": { "type": "string" }, "components": { "type": "object", "additionalProperties": { "type": "string" } } } },
          "database": { "type": "object", "required": ["status", "quick_status", "logical_size_bytes", "microstructure_logical_size_bytes"], "properties": { "status": { "type": "string" }, "quick_status": { "type": "string" }, "logical_size_bytes": { "type": "integer" }, "microstructure_logical_size_bytes": { "type": "integer" } } },
          "wal_size_bytes": { "type": "integer" },
          "maintenance": { "type": "object", "required": ["status", "telemetry_available"], "properties": { "status": { "type": "string" }, "telemetry_available": { "type": "boolean" }, "last_duration_ms": { "type": "number", "nullable": true }, "checkpoint_duration_ms": { "type": "number", "nullable": true }, "paused_reason": { "type": "string", "nullable": true } }, "additionalProperties": true },
          "scheduler": { "type": "object", "required": ["running"], "properties": { "running": { "type": "boolean" }, "last_cycle_completed_at": { "allOf": [{ "$ref": "#/components/schemas/IsoTimestamp" }], "nullable": true }, "last_cycle_duration_ms": { "type": "number", "nullable": true } } },
          "tasks": { "type": "object", "required": ["current_count", "queued_count", "recent_completed"], "properties": { "current_count": { "type": "integer" }, "queued_count": { "type": "integer" }, "recent_completed": { "type": "array", "items": { "type": "object", "required": ["id", "job_type", "status"], "properties": { "id": { "type": "integer" }, "job_type": { "type": "string" }, "status": { "type": "string" }, "completed_at": { "allOf": [{ "$ref": "#/components/schemas/IsoTimestamp" }], "nullable": true } } } } } },
          "warning_count": { "type": "integer" },
          "storage": {
            "type": "object",
            "required": ["root", "paper_database_bytes", "microstructure_database_bytes", "snapshot_mode", "raw_retention_status", "projection", "protection"],
            "properties": {
              "root": {
                "type": "object",
                "required": ["total_bytes", "used_bytes", "free_bytes", "usage_percent"],
                "properties": {
                  "total_bytes": { "type": "integer" },
                  "used_bytes": { "type": "integer" },
                  "free_bytes": { "type": "integer" },
                  "usage_percent": { "type": "number" }
                }
