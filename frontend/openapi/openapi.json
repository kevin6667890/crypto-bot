              "protection": { "type": "object", "required": ["level", "core_ledger_allowed", "optional_artifacts_allowed"], "properties": { "level": { "type": "string", "enum": ["NORMAL", "WARNING", "CRITICAL", "EMERGENCY"] }, "core_ledger_allowed": { "type": "boolean" }, "optional_artifacts_allowed": { "type": "boolean" } }, "additionalProperties": true }
