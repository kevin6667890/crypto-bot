      "DataCoverageItem": { "type": "object", "required": ["instrument", "timeframe", "rows", "first_ts", "last_ts"], "properties": { "instrument": { "type": "string" }, "timeframe": { "type": "string" }, "rows": { "type": "integer" }, "first_ts": { "allOf": [{ "$ref": "#/components/schemas/UnixSeconds" }], "nullable": true }, "last_ts": { "allOf": [{ "$ref": "#/components/schemas/UnixSeconds" }], "nullable": true } } },
