{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "key_level_v1.schema.json", "title": "KeyLevel v1", "type": "object", "additionalProperties": false,
  "required": ["level_id", "price", "zone_low", "zone_high", "source_type", "timeframe", "first_detected", "last_tested", "touches", "strength", "role", "state", "confluences", "invalidation_rule", "evidence_paths"],
  "properties": {"level_id": {"type": "string", "minLength": 1}, "price": {"$ref": "common_defs_v1.schema.json#/$defs/traced_number"}, "zone_low": {"$ref": "common_defs_v1.schema.json#/$defs/traced_number"}, "zone_high": {"$ref": "common_defs_v1.schema.json#/$defs/traced_number"}, "source_type": {"enum": ["RANGE_HIGH", "RANGE_LOW", "BREAKOUT_PLATFORM", "PRIOR_HIGH", "PRIOR_LOW", "SWING_HIGH", "SWING_LOW", "MA20", "MA30", "MA60", "MA200", "EMA20", "VPVR_POC", "VPVR_VAH", "VPVR_VAL", "PSYCHOLOGICAL", "CONFLUENCE"]}, "timeframe": {"enum": ["15m", "1H", "4H", "1D", "1W", "MULTI"]}, "first_detected": {"$ref": "common_defs_v1.schema.json#/$defs/timestamp"}, "last_tested": {"type": ["string", "null"], "format": "date-time"}, "touches": {"type": "integer", "minimum": 0}, "strength": {"enum": ["STRONG", "MODERATE", "WEAK", "UNCONFIRMED"]}, "role": {"enum": ["SUPPORT", "RESISTANCE", "PIVOT"]}, "state": {"enum": ["ACTIVE", "BROKEN", "FLIPPED", "UNCONFIRMED"]}, "confluences": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "invalidation_rule": {"type": "string", "minLength": 1}, "evidence_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^/"}}}
}
