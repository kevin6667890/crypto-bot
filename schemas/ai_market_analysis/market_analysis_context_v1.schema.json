{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "market_analysis_context_v1.schema.json", "title": "MarketAnalysisContext v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "context_id", "instrument", "generated_at", "decision_time", "latest_confirmed_market_time", "requested_analysis_mode", "source_versions", "data_watermarks", "data_quality", "timeframe_structures", "structure_events", "market_timeline", "order_flow_phases", "key_levels", "scenario_tree", "position_context", "macro_context", "current_core_question", "unsupported_claims", "provenance"],
  "properties": {
    "schema_version": {"const": "market-analysis-context-v1"}, "context_id": {"type": "string", "pattern": "^ctx_[a-z0-9_-]+$"}, "instrument": {"enum": ["BTC-USDT-SWAP", "ETH-USDT-SWAP", "SOL-USDT-SWAP"]}, "generated_at": {"$ref": "common_defs_v1.schema.json#/$defs/timestamp"}, "decision_time": {"$ref": "common_defs_v1.schema.json#/$defs/timestamp"}, "latest_confirmed_market_time": {"$ref": "common_defs_v1.schema.json#/$defs/timestamp"}, "requested_analysis_mode": {"enum": ["QUICK", "FULL", "POSITION_AWARE"]},
    "source_versions": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}}, "data_watermarks": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "common_defs_v1.schema.json#/$defs/timestamp"}}, "data_quality": {"$ref": "common_defs_v1.schema.json#/$defs/data_quality"},
    "timeframe_structures": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "timeframe_structure_v1.schema.json"}}, "structure_events": {"type": "array", "items": {"$ref": "market_structure_event_v1.schema.json"}}, "multi_timeframe_summary": {"type": "object"},
    "market_timeline": {"type": "object", "additionalProperties": false, "required": ["observation_window", "compression_start", "compression_end", "range_low", "range_high", "breakout_timestamp", "breakout_direction", "breakout_candle", "breakout_volume_ratio", "impulse_high", "impulse_low", "pullback_start", "current_phase"], "properties": {"observation_window": {"type": "object", "required": ["start", "end"], "properties": {"start": {"$ref": "common_defs_v1.schema.json#/$defs/timestamp"}, "end": {"$ref": "common_defs_v1.schema.json#/$defs/timestamp"}}, "additionalProperties": false}, "compression_start": {"type": ["string", "null"], "format": "date-time"}, "compression_end": {"type": ["string", "null"], "format": "date-time"}, "range_low": {"$ref": "common_defs_v1.schema.json#/$defs/traced_number"}, "range_high": {"$ref": "common_defs_v1.schema.json#/$defs/traced_number"}, "breakout_timestamp": {"type": ["string", "null"], "format": "date-time"}, "breakout_direction": {"enum": ["UP", "DOWN", "NONE", "UNKNOWN"]}, "breakout_candle": {"type": ["string", "null"], "pattern": "^/"}, "breakout_volume_ratio": {"$ref": "common_defs_v1.schema.json#/$defs/traced_number"}, "impulse_high": {"$ref": "common_defs_v1.schema.json#/$defs/traced_number"}, "impulse_low": {"$ref": "common_defs_v1.schema.json#/$defs/traced_number"}, "pullback_start": {"type": ["string", "null"], "format": "date-time"}, "current_phase": {"enum": ["RANGE_BUILDING", "COMPRESSION", "BREAKOUT_ATTEMPT", "BREAKOUT_CONFIRMED", "IMPULSE", "POST_BREAKOUT_PULLBACK", "RETEST", "CONTINUATION", "FAILED_BREAKOUT", "REVERSAL", "UNCLASSIFIED"]}}},
    "order_flow_phases": {"type": "array", "items": {"$ref": "order_flow_phase_v1.schema.json"}}, "phase_transitions": {"type": "array", "items": {"type": "object"}}, "key_levels": {"type": "array", "items": {"$ref": "key_level_v1.schema.json"}}, "scenario_tree": {"$ref": "scenario_tree_v1.schema.json"}, "position_context": {"$ref": "position_plan_context_v1.schema.json"}, "macro_context": {"$ref": "macro_evidence_v1.schema.json"}, "current_core_question": {"type": "string", "minLength": 1}, "unsupported_claims": {"type": "array", "items": {"type": "string"}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["builder", "builder_version", "input_snapshot_ids", "causal_cutoff", "content_hash"], "properties": {"builder": {"type": "string", "minLength": 1}, "builder_version": {"type": "string", "minLength": 1}, "input_snapshot_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "causal_cutoff": {"$ref": "common_defs_v1.schema.json#/$defs/timestamp"}, "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}
  }
}
