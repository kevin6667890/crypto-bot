{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "market_structure_event_v1.schema.json", "title": "MarketStructureEvent v1",
  "type": "object", "additionalProperties": false, "required": ["event_id", "event_type", "timeframe", "start", "end", "direction", "confirmation_status", "source_bar_timestamps", "evidence", "invalidation"],
  "properties": {"event_id": {"type": "string", "minLength": 1}, "event_type": {"enum": ["RANGE_BUILDING", "COMPRESSION", "BREAKOUT_ATTEMPT", "BREAKOUT_CONFIRMED", "IMPULSE", "POST_BREAKOUT_PULLBACK", "RETEST", "CONTINUATION", "FAILED_BREAKOUT", "REVERSAL", "UNCLASSIFIED"]}, "timeframe": {"enum": ["15m", "1H", "4H", "1D", "1W", "MULTI"]}, "start": {"$ref": "common_defs_v1.schema.json#/$defs/timestamp"}, "end": {"$ref": "common_defs_v1.schema.json#/$defs/timestamp"}, "direction": {"enum": ["UP", "DOWN", "NONE", "UNKNOWN"]}, "confirmation_status": {"enum": ["CONFIRMED", "UNCONFIRMED", "FAILED", "UNKNOWN"]}, "source_bar_timestamps": {"type": "array", "minItems": 1, "items": {"$ref": "common_defs_v1.schema.json#/$defs/timestamp"}}, "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "common_defs_v1.schema.json#/$defs/evidence"}}, "invalidation": {"type": "string", "minLength": 1}}
}
