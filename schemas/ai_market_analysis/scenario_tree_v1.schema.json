{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenario_tree_v1.schema.json",
  "title": "ScenarioTree v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenarios"],
  "properties": {
    "status": {"enum": ["AVAILABLE", "NOT_IMPLEMENTED"]},
    "scenarios": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario_type", "likelihood", "trigger", "confirmation", "expected_path", "targets", "invalidation", "volume_confirmation", "cvd_confirmation", "oi_confirmation", "contradictory_evidence"],
        "properties": {
          "scenario_type": {"enum": ["BULLISH_CONTINUATION", "NORMAL_RETEST", "FAILED_BREAKOUT"]},
          "likelihood": {"enum": ["HIGH", "MEDIUM", "LOW", "UNRANKED"]},
          "trigger": {"type": "string", "minLength": 1},
          "confirmation": {"type": "string", "minLength": 1},
          "expected_path": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "targets": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^/"}},
          "invalidation": {"type": "string", "minLength": 1},
          "volume_confirmation": {"type": "string", "minLength": 1},
          "cvd_confirmation": {"type": "string", "minLength": 1},
          "oi_confirmation": {"type": "string", "minLength": 1},
          "contradictory_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "common_defs_v1.schema.json#/$defs/evidence"}}
        }
      }
    }
  },
  "allOf": [{
    "if": {"properties": {"status": {"const": "NOT_IMPLEMENTED"}}, "required": ["status"]},
    "then": {"properties": {"scenarios": {"maxItems": 0}}},
    "else": {"properties": {"scenarios": {"minItems": 3, "maxItems": 3, "contains": {"properties": {"scenario_type": {"const": "FAILED_BREAKOUT"}}, "required": ["scenario_type"]}}}}
  }]
}
